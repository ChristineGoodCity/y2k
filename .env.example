# Next.js configuration; wp:setup generates .env.local automatically.
WORDPRESS_GRAPHQL_URL=http://localhost:8081/graphql

# Docker WordPress: optional ACF PRO license (requires the PRO plugin).
ACF_PRO_LICENSE=

# Optional: snapshot uses the exported preview even when WordPress is configured.
# With no WordPress URL, the saved preview is used automatically.
# CONTENT_SOURCE=snapshot
